---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.tsx';
import contacto from '../../content/contacto.json';
import settings from '../../content/settings.json';
---

<Layout title="Contacto" description="Comunícate con Fundación Corazón Late.">

  <div class="bg-brand-red text-white py-16 text-center">
    <div class="max-w-3xl mx-auto px-6">
      <h1 class="text-4xl font-serif font-bold mb-3">{contacto.header.title}</h1>
      <p class="text-white/80">{contacto.header.subtitle}</p>
    </div>
  </div>

  <section class="max-w-5xl mx-auto px-6 py-20 grid grid-cols-1 md:grid-cols-2 gap-12">
    <!-- Contact info -->
    <div>
      <h2 class="section-title mb-2">{contacto.info.title}</h2>
      <span class="section-underline"></span>
      <p class="text-brand-text/80 leading-relaxed mb-8">{contacto.info.text}</p>
      <ul class="space-y-4">
        <li class="flex items-start gap-3">
          <div class="w-10 h-10 rounded-full bg-brand-terracotta/10 flex items-center justify-center flex-shrink-0 mt-0.5">
            <svg class="w-5 h-5 text-brand-terracotta" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <p class="text-sm font-semibold text-brand-text">Correo electrónico</p>
            <a href={`mailto:${settings.contact_email}`} class="text-brand-terracotta text-sm hover:underline">{settings.contact_email}</a>
          </div>
        </li>
        {settings.instagram_url && (
          <li class="flex items-start gap-3">
            <div class="w-10 h-10 rounded-full bg-brand-terracotta/10 flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-5 h-5 text-brand-terracotta" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-brand-text">Instagram</p>
              <a href={settings.instagram_url} target="_blank" rel="noopener" class="text-brand-terracotta text-sm hover:underline">{settings.instagram_handle}</a>
            </div>
          </li>
        )}
        {settings.phone && (
          <li class="flex items-start gap-3">
            <div class="w-10 h-10 rounded-full bg-brand-terracotta/10 flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-5 h-5 text-brand-terracotta" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
            </div>
            <div>
              <p class="text-sm font-semibold text-brand-text">Teléfono</p>
              <a href={`tel:${settings.phone}`} class="text-brand-terracotta text-sm hover:underline">{settings.phone}</a>
            </div>
          </li>
        )}
      </ul>
    </div>

    <!-- Contact form -->
    <ContactForm client:load />
  </section>

</Layout>
