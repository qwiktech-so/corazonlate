---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contacto" description="Comunícate con Fundación Corazón Late.">

  <div class="bg-brand-red text-white py-16 text-center">
    <div class="max-w-3xl mx-auto px-6">
      <h1 class="text-4xl font-serif font-bold mb-3">Contacto</h1>
      <p class="text-white/80">Estamos aquí para escucharte. Escríbenos.</p>
    </div>
  </div>

  <section class="max-w-5xl mx-auto px-6 py-20 grid grid-cols-1 md:grid-cols-2 gap-12">
    <!-- Contact info -->
    <div>
      <h2 class="section-title mb-2">Hablemos</h2>
      <span class="section-underline"></span>
      <p class="text-brand-text/80 leading-relaxed mb-8">
        Si tienes preguntas, quieres aliarte con nuestra fundación, o simplemente deseas conocer más
        sobre lo que hacemos, escríbenos.
      </p>
      <ul class="space-y-4">
        <li class="flex items-start gap-3">
          <div class="w-10 h-10 rounded-full bg-brand-terracotta/10 flex items-center justify-center flex-shrink-0 mt-0.5">
            <svg class="w-5 h-5 text-brand-terracotta" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <p class="text-sm font-semibold text-brand-text">Correo electrónico</p>
            <a href="mailto:info@corazonlate.org" class="text-brand-terracotta text-sm hover:underline">info@corazonlate.org</a>
          </div>
        </li>
        <li class="flex items-start gap-3">
          <div class="w-10 h-10 rounded-full bg-brand-terracotta/10 flex items-center justify-center flex-shrink-0 mt-0.5">
            <svg class="w-5 h-5 text-brand-terracotta" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </div>
          <div>
            <p class="text-sm font-semibold text-brand-text">Instagram</p>
            <a href="#" class="text-brand-terracotta text-sm hover:underline">@corazonlate</a>
          </div>
        </li>
      </ul>
    </div>

    <!-- Contact form -->
    <div class="bg-white rounded-3xl p-8 shadow-sm">
      <h3 class="font-serif font-bold text-xl text-brand-red mb-6">Envíanos un mensaje</h3>
      <form
        name="contacto"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="space-y-4"
      >
        <input type="hidden" name="form-name" value="contacto" />
        <p class="hidden">
          <label>No llenar: <input name="bot-field" /></label>
        </p>
        <input
          type="text"
          name="nombre"
          placeholder="Tu nombre*"
          required
          class="w-full rounded-full border border-brand-border px-5 py-3 text-sm outline-none focus:border-brand-terracotta"
        />
        <input
          type="email"
          name="correo"
          placeholder="Tu correo*"
          required
          class="w-full rounded-full border border-brand-border px-5 py-3 text-sm outline-none focus:border-brand-terracotta"
        />
        <textarea
          name="mensaje"
          placeholder="Tu mensaje*"
          required
          rows={5}
          class="w-full rounded-2xl border border-brand-border px-5 py-3 text-sm outline-none focus:border-brand-terracotta resize-none"
        ></textarea>
        <button type="submit" class="btn-primary w-full text-center">Enviar mensaje</button>
      </form>
    </div>
  </section>

</Layout>
