---
import Layout from '../layouts/Layout.astro';
import donaciones from '../../content/donaciones.json';
---

<Layout title="Donaciones" description="Apoya a Fundación Corazón Late con una donación y transforma vidas.">

  <div class="bg-brand-red text-white py-16 text-center">
    <div class="max-w-3xl mx-auto px-6">
      <h1 class="text-4xl font-serif font-bold mb-3">{donaciones.header.title}</h1>
      <p class="text-white/80 text-lg">{donaciones.header.subtitle}</p>
    </div>
  </div>

  <section class="max-w-3xl mx-auto px-6 py-20 text-center">
    <h2 class="section-title">{donaciones.intro.title}</h2>
    <span class="section-underline mx-auto"></span>
    <p class="text-brand-text/80 leading-relaxed mt-4 mb-8 max-w-xl mx-auto">{donaciones.intro.text}</p>

    <!-- Impact cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-12 text-left">
      {donaciones.impact_cards.map(card => (
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-brand-border">
          <p class="text-3xl font-bold text-brand-terracotta mb-2">{card.amount}</p>
          <p class="text-sm text-brand-text/70 leading-relaxed">{card.impact}</p>
        </div>
      ))}
    </div>

    <!-- Payment options -->
    <div class="flex flex-col sm:flex-row gap-6 justify-center items-stretch">

      {donaciones.paypal.enabled && (
        <div class="bg-white rounded-3xl p-8 shadow-sm flex flex-col items-center justify-between">
          <p class="text-brand-text font-semibold mb-6 text-base">{donaciones.paypal.label}</p>
          <form action="https://www.paypal.com/donate" method="post" target="_top">
            <input type="hidden" name="hosted_button_id" value={donaciones.paypal.hosted_button_id} />
            <button
              type="submit"
              class="flex items-center gap-3 bg-[#0070BA] hover:bg-[#005ea6] text-white font-bold text-base px-8 py-4 rounded-full transition-colors mx-auto cursor-pointer"
            >
              <svg viewBox="0 0 24 24" class="w-5 h-5 fill-white flex-shrink-0" xmlns="http://www.w3.org/2000/svg">
                <path d="M7.076 21.337H2.47a.641.641 0 0 1-.633-.74L4.944.901C5.026.382 5.474 0 5.998 0h7.46c2.57 0 4.578.543 5.69 1.81 1.01 1.15 1.304 2.42 1.012 4.287-.023.143-.047.288-.077.437-.983 5.05-4.349 6.797-8.647 6.797h-2.19c-.524 0-.968.382-1.05.9l-1.12 7.106zm14.146-14.42a3.35 3.35 0 0 0-.607-.541c-.013.076-.026.175-.041.254-.59 3.025-2.566 6.082-8.558 6.082H9.825l-1.435 9.085h4.107a.644.644 0 0 0 .636-.554l.026-.13.504-3.184.032-.174a.644.644 0 0 1 .636-.554h.4c2.59 0 4.62-.529 5.214-2.056.58-1.5.288-2.733-.323-3.228z"/>
              </svg>
              {donaciones.paypal.label}
            </button>
          </form>
          <p class="text-xs text-brand-text/50 mt-5">Pago seguro procesado por PayPal</p>
        </div>
      )}

      {donaciones.paypal.enabled && donaciones.bank.enabled && (
        <div class="flex sm:flex-col items-center gap-3 text-brand-text/30 text-sm font-medium">
          <div class="flex-1 h-px sm:h-auto sm:w-px bg-brand-border"></div>
          <span>o</span>
          <div class="flex-1 h-px sm:h-auto sm:w-px bg-brand-border"></div>
        </div>
      )}

      {donaciones.bank.enabled && (
        <div class="bg-white rounded-3xl p-8 shadow-sm flex flex-col text-left min-w-[240px]">
          <div class="flex items-center gap-2 mb-5">
            <div class="w-8 h-8 rounded-full bg-brand-terracotta/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4 text-brand-terracotta" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
              </svg>
            </div>
            <p class="text-brand-text font-semibold text-base">{donaciones.bank.label}</p>
          </div>
          <dl class="space-y-3">
            {donaciones.bank.fields.map(row => (
              <div class="flex justify-between gap-4 text-sm border-b border-brand-border pb-2 last:border-0 last:pb-0">
                <dt class="text-brand-text/50 font-medium flex-shrink-0">{row.label}</dt>
                <dd class="text-brand-text font-semibold text-right">{row.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      )}

    </div>
  </section>

  <!-- CTA Volunteer -->
  <section class="bg-cream py-16 text-center border-t border-brand-border">
    <div class="max-w-xl mx-auto px-6">
      <h3 class="text-xl font-serif font-bold text-brand-red mb-3">{donaciones.volunteer_cta.title}</h3>
      <p class="text-brand-text/70 text-sm mb-6">{donaciones.volunteer_cta.text}</p>
      <a href={donaciones.volunteer_cta.button_url} class="btn-outline inline-block">{donaciones.volunteer_cta.button_label}</a>
    </div>
  </section>

</Layout>
