---
import Layout from '../layouts/Layout.astro';
import nosotros from '../../content/nosotros.json';
---

<Layout title="Nosotros" description="Conoce la historia y misión de Fundación Corazón Late.">

  <!-- Page Header -->
  <div class="bg-brand-red text-white py-16 text-center">
    <div class="max-w-3xl mx-auto px-6">
      <h1 class="text-4xl md:text-5xl font-serif font-bold mb-3">{nosotros.header.title}</h1>
      <p class="text-white/80 text-lg">{nosotros.header.subtitle}</p>
    </div>
  </div>

  <!-- Misión / Visión -->
  <section class="max-w-5xl mx-auto px-6 py-20 grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
    <div>
      <h2 class="section-title">{nosotros.mission.title}</h2>
      <span class="section-underline"></span>
      <p class="text-brand-text/80 leading-relaxed">{nosotros.mission.text}</p>
    </div>
    <div>
      <h2 class="section-title">{nosotros.vision.title}</h2>
      <span class="section-underline"></span>
      <p class="text-brand-text/80 leading-relaxed">{nosotros.vision.text}</p>
    </div>
  </section>

  <!-- Valores -->
  <section class="bg-white py-20">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="section-title">{nosotros.values.title}</h2>
        <span class="section-underline mx-auto"></span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {nosotros.values.items.map(v => (
          <div class="bg-cream rounded-2xl p-6 text-center">
            <div class="text-4xl mb-3">{v.icon}</div>
            <h3 class="font-bold text-brand-red mb-2">{v.title}</h3>
            <p class="text-sm text-brand-text/70 leading-relaxed">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Historia -->
  <section class="max-w-3xl mx-auto px-6 py-20">
    <h2 class="section-title text-center">{nosotros.history.title}</h2>
    <span class="section-underline mx-auto"></span>
    <p class="text-brand-text/80 leading-relaxed mt-4">{nosotros.history.paragraph_1}</p>
    <p class="text-brand-text/80 leading-relaxed mt-4">{nosotros.history.paragraph_2}</p>
  </section>

  <!-- CTA -->
  <section class="bg-brand-terracotta text-white py-16 text-center">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="text-2xl font-serif font-bold mb-4">{nosotros.cta.title}</h2>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href={nosotros.cta.primary_url} class="bg-white text-brand-terracotta font-bold px-8 py-3 rounded-full hover:bg-cream transition-colors">{nosotros.cta.primary_label}</a>
        <a href={nosotros.cta.secondary_url} class="border-2 border-white text-white font-semibold px-8 py-3 rounded-full hover:bg-white/10 transition-colors">{nosotros.cta.secondary_label}</a>
      </div>
    </div>
  </section>

</Layout>
